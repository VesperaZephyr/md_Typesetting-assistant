{
  "name": "魔法学院 · 绛红鎏金",
  "styles": {
    "root": "font-size:15px;color:#2d2326;line-height:1.9;font-family:Optima-Regular, Optima, PingFangSC-light, PingFang TC, \"PingFang SC\", Cambria, Cochin, Georgia, Times, -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Microsoft YaHei\", sans-serif;word-break:break-word;letter-spacing:0.5px;text-align:justify;text-justify:inter-ideograph;background:#fffaf0;padding:20px 18px;",
    "p": "margin:1.2em 0;line-height:1.9;",
    "h1": "display:inline-block;margin:1.4em 0 0.7em;padding-bottom:8px;font-size:23px;font-weight:bold;line-height:1.35;text-align:left;color:#5c0f1c;font-family:\"Kaiti SC\", STKaiti, KaiTi, \"Songti SC\", Georgia, serif;border-bottom:3px solid #c79a2a;",
    "h2": "margin:2.2em 0 1.1em;padding-bottom:10px;font-size:19px;font-weight:bold;line-height:1.4;text-align:center;letter-spacing:1px;color:#5c0f1c;font-family:\"Kaiti SC\", STKaiti, KaiTi, \"Songti SC\", Georgia, serif;border-bottom:1px solid #ecd3cf;",
    "h3": "display:inline-block;position:relative;z-index:1;margin:1.8em 0 -14px 6px;padding:3px 14px;font-size:14px;font-weight:bold;line-height:1.6;letter-spacing:0.5px;color:#8c1d2c;background:#ffffff;border-radius:8px;box-shadow:0 2px 8px rgba(140,29,44,0.22);",
    "h4": "display:inline-block;margin:1.6em 0 0.6em;padding:2px 13px;font-size:13.5px;font-weight:bold;line-height:1.7;color:#fff3d6;background:#8c1d2c;border-radius:999px;",
    "h5": "margin:1.2em 0 0.5em;font-size:15px;font-weight:bold;color:#8c1d2c;",
    "h6": "margin:1em 0 0.5em;font-size:14px;color:#8a7a7e;",
    "strong": "font-weight:bold;color:#8c1d2c;background:linear-gradient(transparent 62%, #f6e3ae 62%);padding:0 2px;",
    "em": "font-style:italic;color:#8c1d2c;",
    "del": "text-decoration:line-through;color:#8a7a7e;",
    "a": "color:#b0801a;text-decoration:none;border-bottom:1px dotted #b0801a;",
    "ul": "margin:1em 0;padding-left:1.4em;",
    "ol": "margin:1em 0;padding-left:1.6em;",
    "li": "margin:0.5em 0;line-height:1.85;",
    "blockquote": "margin:0 0 1.5em;padding:26px 16px 8px;color:#2d2326;background:#fff7f3;border:1px dashed #dcb7b3;border-radius:12px;",
    "blockquote p": "margin:0.6em 0;line-height:1.85;color:#2d2326;",
    "code": "background:#f8e9e6;color:#8c1d2c;padding:2px 6px;border-radius:4px;font-family:Menlo,Consolas,monospace;font-size:88%;",
    "pre": "background:#2a1f24;border:none;border-radius:8px;padding:14px 16px;overflow-x:auto;margin:1.4em 0;line-height:1.6;",
    "pre code": "background:transparent;color:#abb2bf;padding:0;border-radius:0;font-size:13px;font-family:Menlo,Consolas,monospace;",
    "table": "border-collapse:collapse;width:100%;margin:1.3em 0;font-size:14px;",
    "th": "padding:9px 12px;font-weight:bold;text-align:left;border:1px solid #ecd3cf;background:#f8e9e6;color:#5c0f1c;",
    "td": "padding:8px 12px;border:1px solid #ecd3cf;",
    "img": "max-width:100%;display:block;margin:1.4em auto;border-radius:10px;border:1px solid #ecd3cf;box-shadow:0 4px 14px rgba(140,29,44,0.2);",
    "hr": "height:10px;margin:2em 0;border:none;background-image:radial-gradient(circle, #8c1d2c 2.2px, transparent 3px);background-size:16px 10px;background-repeat:repeat-x;background-position:center;",
    "figcaption": "text-align:center;color:#9a8a8e;font-size:12.5px;margin-top:0.5em;",
    "sup": "font-size:75%;"
  },
